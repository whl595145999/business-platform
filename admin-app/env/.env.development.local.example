# 复制本文件为 .env.development.local（已被 gitignore，每人 IP 不同）
# 微信小程序真机 / 局域网预览时必填，不能用 localhost

# 将 192.168.x.x 换成你电脑在局域网中的 IP（与手机同一 WiFi）
# macOS 查看：系统设置 -> 网络，或终端 ifconfig | grep "inet "
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://192.168.1.100:8080'

# 可选：App 真机调试若也需要局域网，可一并配置
# VITE_SERVER_BASEURL = 'http://192.168.1.100:8080'

# 可选：微信小程序 AppSecret（仅本地，勿提交；移动端工程一般不需要，后端配置）
# VITE_WX_APPSECRET = 'your-app-secret'
