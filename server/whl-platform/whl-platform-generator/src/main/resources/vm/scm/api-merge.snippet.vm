/* merge: 在 wms.ts 顶部 from '@/api/scm/types' 中追加 ${ClassName}VO, ${ClassName}Form, ${ClassName}Query */

/** 分页查询${functionName} */
export const page${ClassName} = (query?: ${ClassName}Query) => {
  return request({
    url: '${scmApiPrefix}',
    method: 'get',
    params: query
  });
};

/** 查询${functionName}详情 */
export const get${ClassName} = (${businessKeyColumn.javaField}: string | number, tenantId?: string) => {
  return request({
    url: '${scmApiPrefix}/' + ${businessKeyColumn.javaField},
    method: 'get',
    params: { tenantId }
  });
};

/** 新增${functionName} */
export const add${ClassName} = (data: ${ClassName}Form) => {
  return request({
    url: '${scmApiPrefix}',
    method: 'post',
    data
  });
};

/** 修改${functionName} */
export const update${ClassName} = (${businessKeyColumn.javaField}: string | number, data: ${ClassName}Form) => {
  return request({
    url: '${scmApiPrefix}/' + ${businessKeyColumn.javaField},
    method: 'put',
    data
  });
};

/** 删除${functionName} */
export const del${ClassName} = (${businessKeyColumn.javaField}: string | number, tenantId?: string) => {
  return request({
    url: '${scmApiPrefix}/' + ${businessKeyColumn.javaField},
    method: 'delete',
    params: { tenantId }
  });
};
