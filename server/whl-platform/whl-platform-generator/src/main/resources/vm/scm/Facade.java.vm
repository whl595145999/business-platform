import java.util.List;

/**
 * ${functionName} Facade（标准 CRUD + 分页#if($scmGenerateOptions) + 下拉选项#end）。
 * <p>
 * 对应表 {@code ${tableName}}，REST 前缀 {@code ${scmApiPrefix}}。
 *
#parse("vm/scm/common/java-doc-footer.vm")
 */
public interface ${ClassName}Facade {

