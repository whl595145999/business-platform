package ${packageScmApi}.facade;

import ${packageScmApi}.command.Create${ClassName}Command;
import ${packageScmApi}.command.Delete${ClassName}Command;
import ${packageScmApi}.command.Update${ClassName}Command;
import ${packageScmApi}.dto.${ClassName}Dto;
import ${packageScmApi}.page.ScmPageResult;
import ${packageScmApi}.query.Get${ClassName}Query;
