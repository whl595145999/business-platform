                <groupId>com.whl</groupId>
                <artifactId>whl-framework-encrypt</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 租户模块 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-tenant</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- WebSocket模块 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-websocket</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- SSE模块 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-sse</artifactId>
                <version>${revision}</version>
            </dependency>

