            </dependency>

            <!-- satoken -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-satoken</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 安全模块 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-security</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 短信模块 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-sms</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-social</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- web服务 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 翻译模块 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-translation</artifactId>
                <version>${revision}</version>
            </dependency>

