            </dependency>

            <!-- 数据库服务 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- OSS -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-oss</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 限流 -->
            <dependency>
                <groupId>com.whl</groupId>
                <artifactId>whl-framework-ratelimiter</artifactId>
